# forge-agent environment configuration
# Copy this file to .env and customize for your environment.

# Daemon settings
FORGE_HOST=127.0.0.1
FORGE_PORT=8765

# Database path (default: ~/.forge/forge.db)
# FORGE_DB_PATH=

# Auth token for remote/network access (empty = no auth required, local dev only)
# FORGE_AUTH_TOKEN=my-secret-token

# Logging level: DEBUG, INFO, WARNING, ERROR
FORGE_LOG_LEVEL=INFO

# Data directory (default: ~/.forge)
# FORGE_DATA_DIR=

# Cloudflare tunnel binary
# FORGE_CLOUDFLARED_BIN=cloudflared
